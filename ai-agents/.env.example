# Nexus Commerce AI Agent Service Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ai-recommendation-group
KAFKA_TOPIC_ORDER_EVENTS=order-events

# LangChain / OpenAI Integration (Optional: System runs heuristic fallback if left blank)
OPENAI_API_KEY=your_openai_api_key_here